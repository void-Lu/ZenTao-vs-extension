{
  "name": "zentao-vs-extension",
  "displayName": "ZenTao VS Extension",
  "description": "Browse ZenTao project stories and tasks in VS Code.",
  "version": "0.6.0",
  "publisher": "void-lu",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:zentaoProjectView"
  ],
  "contributes": {
    "configuration": {
      "title": "ZenTao",
      "properties": {
        "zentao.baseUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "ZenTao base URL, for example https://zentao.example.com/."
        },
        "zentao.projectId": {
          "type": "number",
          "default": 0,
          "scope": "window",
          "description": "ZenTao project ID used by this workspace."
        },
        "zentao.requestTimeout": {
          "type": "number",
          "default": 15000,
          "minimum": 1000,
          "description": "ZenTao request timeout in milliseconds."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zentao",
          "title": "ZenTao",
          "icon": "resources/zentao.svg"
        }
      ]
    },
    "views": {
      "zentao": [
        {
          "id": "zentaoProjectView",
          "name": "禅道项目"
        }
      ]
    },
    "commands": [
      {
        "command": "zentao.reconnect",
        "title": "重新连接",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "zentao.refresh",
        "title": "刷新禅道数据",
        "icon": "$(refresh)"
      },
      {
        "command": "zentao.reselectProject",
        "title": "重新选择项目",
        "icon": "$(list-selection)"
      },
      {
        "command": "zentao.setTreeFilter",
        "title": "筛选禅道条目",
        "icon": "$(filter)"
      },
      {
        "command": "zentao.clearTreeFilter",
        "title": "清除禅道筛选",
        "icon": "$(filter-filled)"
      },
      {
        "command": "zentao.setTreeSort",
        "title": "排序禅道条目",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "zentao.openRequestLog",
        "title": "请求日志",
        "icon": "$(output)"
      },
      {
        "command": "zentao.openDetail",
        "title": "打开禅道详情"
      },
      {
        "command": "zentao.copyId",
        "title": "复制编号"
      },
      {
        "command": "zentao.openExternal",
        "title": "在浏览器打开"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "zentao.reconnect",
          "when": "view == zentaoProjectView",
          "group": "navigation@1"
        },
        {
          "command": "zentao.reselectProject",
          "when": "view == zentaoProjectView",
          "group": "navigation@2"
        },
        {
          "command": "zentao.setTreeFilter",
          "when": "view == zentaoProjectView",
          "group": "navigation@3"
        },
        {
          "command": "zentao.clearTreeFilter",
          "when": "view == zentaoProjectView",
          "group": "navigation@4"
        },
        {
          "command": "zentao.setTreeSort",
          "when": "view == zentaoProjectView",
          "group": "navigation@5"
        },
        {
          "command": "zentao.openRequestLog",
          "when": "view == zentaoProjectView",
          "group": "navigation@6"
        },
        {
          "command": "zentao.refresh",
          "when": "view == zentaoProjectView",
          "group": "navigation@7"
        }
      ],
      "view/item/context": [
        {
          "command": "zentao.openDetail",
          "when": "view == zentaoProjectView && viewItem =~ /^(story|task)$/",
          "group": "inline@1"
        },
        {
          "command": "zentao.copyId",
          "when": "view == zentaoProjectView && viewItem =~ /^(story|task)$/",
          "group": "navigation@1"
        },
        {
          "command": "zentao.openExternal",
          "when": "view == zentaoProjectView && viewItem =~ /^(story|task)$/",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "verify": "npm run compile && npm test",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "mammoth": "^1.12.0",
    "markdown-it": "^14.2.0",
    "pdf-parse": "^2.4.5",
    "read-excel-file": "^9.0.10",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.12.12",
    "@types/sanitize-html": "^2.16.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.3",
    "vitest": "^1.6.1"
  }
}
